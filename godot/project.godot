; Engine configuration file.
config_version=5

[application]
config/name="KodeX"
config/quit_on_go_back=false
config/version="0.20.4-alpha"
run/main_scene="res://carregamento.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.051, 0.043, 0.071, 1)
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Relogio="*res://relogio.gd"
Sessao="*res://sessao.gd"
Nuvem="*res://nuvem.gd"
Som="*res://som.gd"

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
